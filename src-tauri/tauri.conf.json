{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unit Agent",
  "version": "0.1.0",
  "identifier": "com.prysel.unitagent",
  "build": {
    "frontendDist": "../dist-web",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Unit Agent",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420; img-src 'self' data: https: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Prysel",
    "copyright": "Copyright © 2026 Prysel",
    "category": "Development",
    "shortDescription": "Local-first workspace for terminals and Prysel",
    "longDescription": "Unit Agent is a local-first desktop environment for real terminal sessions on macOS, Windows, and Linux, with optional Prysel authentication when the network is available.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "bundleVersion": "0.1.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "windowPosition": {
          "x": 200,
          "y": 120
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/nsis-header.bmp",
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "uninstallerHeaderImage": "windows/nsis-header.bmp"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
