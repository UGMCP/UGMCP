# Unit Agent — Prysel Auth configuration
# Copy to ~/.config/unit-agent/config.env or export in the environment.
# Never commit real secrets. The client secret is read only by the native backend.

# Prysel Auth UI and SSO host. The @prysel/sso SDK calls this origin.
PRYSEL_AUTH_URL=https://auth.prysel.com

# API origin used for POST /api/sso/sessions, POST /api/sso/token, and GET /health.
# Leave identical to PRYSEL_AUTH_URL when auth.prysel.com proxies /api (production default).
PRYSEL_API_URL=https://auth.prysel.com

# Application id registered in Prysel Auth (SSO applications table).
PRYSEL_APP_ID=

# Application client secret. Native backend only. Never expose this to the frontend.
PRYSEL_CLIENT_SECRET=

# Must be allow-listed on the Prysel application callback URLs.
# Hostname and port are validated by Prysel Auth. Default matches PRYSEL_CALLBACK_PORT.
PRYSEL_REDIRECT_URI=http://127.0.0.1:47821/callback

# Fixed loopback port for the desktop authorization callback.
PRYSEL_CALLBACK_PORT=47821

# Local session lifetime after a successful code exchange. The SSO SDK does not
# return a refresh token; Unit Agent stores the profile in the OS secret store.
PRYSEL_SESSION_TTL_HOURS=168

# Optional online agent base URL. When unset, the agent service reports
# "Online agent service is not configured."
PRYSEL_AGENT_URL=
