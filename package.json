{
  "name": "unit-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Unit Agent — local-first desktop workspace for macOS, Windows, and Linux, with a headless server and Prysel authentication.",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "tsc --noEmit",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "serve": "cargo run --manifest-path src-tauri/Cargo.toml --bin unit-agent-server --"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
